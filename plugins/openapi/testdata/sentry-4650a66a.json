{
  "openapi": "3.0.3",
  "info": {
    "title": "API Reference",
    "version": "v0",
    "description": "Sentry Public API",
    "termsOfService": "http://sentry.io/terms/",
    "contact": {
      "email": "partners@sentry.io"
    },
