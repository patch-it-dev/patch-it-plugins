{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/patch-it-dev/patch-it-plugins/blob/main/docs/plugins.schema.json",
  "title": "patch-it plugins",
  "description": "docs/plugins.json: every registered plugin, generated by `make plugins-json` from the plugin registry and docs/plugins.md.",
  "type": "object",
  "required": ["_comment", "$schema", "count", "plugins"],
  "additionalProperties": false,
  "properties": {
    "_comment": { "type": "string" },
    "$schema": { "type": "string" },
    "count": { "type": "integer", "description": "How many plugins are listed." },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "provider", "layer", "watches", "format", "source_url", "status", "provider_page"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "description": "The plugin's --api id and every event's api field." },
          "provider": { "type": "string", "minLength": 1 },
          "layer": { "type": "string", "enum": ["api", "sdk", "package", "runtime", "ci", "ai-models"] },
          "watches": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "enum": ["openapi", "retirements", "migrationguide", "removedmembers", "changelog", "feed", "apichangelog"] },
          "source_url": { "type": "string", "pattern": "^https://" },
          "status": { "type": "string", "enum": ["live", "paused", "planned"] },
          "status_note": { "type": "string", "description": "Why, for a paused plugin." },
          "provider_page": { "type": "string", "pattern": "^providers/[a-z0-9][a-z0-9.-]*\\.md$" }
        }
      }
    }
  }
}
