{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/patch-it-dev/patch-it-plugins/blob/main/docs/plugins.schema.json",
  "title": "patch-it plugins",
  "description": "plugins.json: every registered provider and its sources, printed by `go run ./cmd/list-plugins` from the plugin registry and attached to each release. Never committed.",
  "type": "object",
  "required": ["_comment", "$schema", "version", "provider_count", "source_count", "categories", "providers"],
  "additionalProperties": false,
  "properties": {
    "_comment": { "type": "string" },
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1, "description": "The release tag it was built from, or main." },
    "provider_count": { "type": "integer" },
    "source_count": { "type": "integer" },
    "categories": {
      "type": "array",
      "description": "Every category, in display order.",
      "items": { "type": "string", "enum": ["ai", "payments", "infrastructure", "databases", "monitoring", "analytics", "auth", "messaging", "hosting", "search", "devtools", "crm", "packages"] }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "homepage", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["ai", "payments", "infrastructure", "databases", "monitoring", "analytics", "auth", "messaging", "hosting", "search", "devtools", "crm", "packages"] },
          "homepage": { "type": "string", "pattern": "^https://" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "alias", "kind", "layer", "watches", "urls", "page"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$", "description": "provider/source" },
                "alias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$", "description": "The old slug: --api and every event's api field until patch-it's change-event contract switches to source ids." },
                "kind": { "type": "string", "enum": ["openapi", "retirements", "migrationguide", "removedmembers", "changelog", "feed", "apichangelog", "catalog", "eol"] },
                "layer": { "type": "string", "enum": ["api", "sdk", "package", "runtime", "ci", "ai-models", "infra"] },
                "watches": { "type": "string", "minLength": 1 },
                "urls": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
                "page": { "type": "string", "pattern": "^https://github\\.com/patch-it-dev/patch-it-plugins/blob/[^/]+/providers/[a-z0-9][a-z0-9.-]*\\.md$" }
              }
            }
          }
        }
      }
    }
  }
}
